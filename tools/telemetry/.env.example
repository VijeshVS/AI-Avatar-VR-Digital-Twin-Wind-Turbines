# Copy to .env and fill in the key. Any OpenAI-compatible endpoint works:
# OpenAI, Groq, OpenRouter, Together, vLLM, LM Studio, or Ollama at
# http://localhost:11434/v1.
#
# An empty key is a supported mode: the service falls back to the deterministic
# rule narrator, and the demo still works offline.

VRAR_LLM_API_KEY=
VRAR_LLM_BASE_URL=https://api.openai.com/v1
VRAR_LLM_MODEL=gpt-4o-mini
VRAR_LLM_TIMEOUT_S=12
